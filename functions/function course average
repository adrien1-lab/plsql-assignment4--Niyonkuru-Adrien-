--
PROMPT Compiling function FN_COURSE_AVERAGE ...

CREATE OR REPLACE FUNCTION fn_course_average (
    p_course_id IN courses.course_id%TYPE,
    p_semester  IN enrollments.semester%TYPE DEFAULT '2026-FALL'
) RETURN NUMBER
IS
    v_course_id  courses.course_id%TYPE;
    v_avg        NUMBER;
BEGIN
    -- Confirm the course exists (a missing course raises NO_DATA_FOUND).
    SELECT course_id
    INTO   v_course_id
    FROM   courses
    WHERE  course_id = p_course_id;

    -- Implicit cursor: one aggregate row into one variable.
    SELECT AVG(score)
    INTO   v_avg
    FROM   enrollments
    WHERE  course_id = p_course_id
    AND    semester  = p_semester
    AND    score IS NOT NULL;

    RETURN ROUND(v_avg, 2);   -- stays NULL when no scores exist yet

EXCEPTION
    WHEN NO_DATA_FOUND THEN
        RAISE_APPLICATION_ERROR(
            -20042,
            'Course ' || p_course_id || ' does not exist. Cannot compute the average.');
END fn_course_average;
/

