--

CREATE OR REPLACE FUNCTION fn_course_seats_left (
    p_course_id IN courses.course_id%TYPE,
    p_semester  IN enrollments.semester%TYPE DEFAULT '2026-FALL'
) RETURN NUMBER
IS
    v_capacity NUMBER;
    v_enrolled NUMBER;
BEGIN
    -- One row per course id; a missing course raises NO_DATA_FOUND.
    SELECT capacity
    INTO   v_capacity
    FROM   courses
    WHERE  course_id = p_course_id;

    SELECT COUNT(*)
    INTO   v_enrolled
    FROM   enrollments
    WHERE  course_id = p_course_id
    AND    semester  = p_semester;

    -- GREATEST keeps the result sensible even if a course was ever
    -- over-enrolled manually (never report a negative seat count).
    RETURN GREATEST(v_capacity - v_enrolled, 0);

EXCEPTION
    WHEN NO_DATA_FOUND THEN
        RAISE_APPLICATION_ERROR(
            -20042,
            'Course ' || p_course_id || ' does not exist. Cannot check seats.');
END fn_course_seats_left;
/
